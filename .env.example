# Django Settings
DJANGO_SECRET_KEY=django-insecure-sotuvpro-super-secret-key-change-in-production-2026
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,web
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006,http://127.0.0.1:3000,http://127.0.0.1:5173

# PostgreSQL Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sotuvpro_db
DB_USER=sotuvpro_user
DB_PASSWORD=sotuvpro_secure_password_2026
DB_HOST=db
DB_PORT=5432

# Redis & Channels
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=720
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Eskiz.uz SMS Gateway
ESKIZ_EMAIL=your_email@domain.uz
ESKIZ_PASSWORD=your_eskiz_password_or_token
ESKIZ_FROM=4546
ESKIZ_IS_TEST=True
